# Secrets only. Everything else goes in config.yaml (see config.example.yaml).
# Copy to .env, which is git-ignored. Never commit real values.

# Required when llm.provider is "anthropic" (the default).
ANTHROPIC_API_KEY=

# Required with the provided docker-compose.yml: the bundled Qdrant refuses
# requests without it, and compose refuses to start without it. Generate one:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
QDRANT_API_KEY=
